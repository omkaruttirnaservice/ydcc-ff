doctype html
html
    head
        meta(charset="utf-8")
        meta(http-equiv='X-UA-Compatible' content='IE=edge')
        meta(http-equiv='Cache-control' content='no-cache')
        meta(http-equiv='Expires' content='-1')
        meta(name='viewport' content='width=device-width, initial-scale=1.0, minimum-scale=1.0, maximum-scale=1.0, user-scalable=0')

        include ./favicon.pug

        link(rel="stylesheet", href=CDNS.bootstrapCSS)
        link(rel="stylesheet", href=CDNS.fontAwesomeCSS)
        link(rel="stylesheet", href=CDNS.sweetAlertCSS)

        link(rel="stylesheet", href=CDNS.customCommonStylesCss)
        link(rel="stylesheet", href=CDNS.customCommonNavbarCss)
        link(rel="stylesheet", href=CDNS.customCommonProgressNavbarCss)


        block css_link
        block aggrement_page_css_link
        block inline_css

        script(src=CDNS.jquery)
        script(src=CDNS.jqueryValidate)
        script(src=CDNS.jqueryValidateAdditional)

        script(src=CDNS.bootstrapJS)
        script(src=CDNS.sweetAlertJs)
        script(src=CDNS.fontAwesomeJS)

        script(src=CDNS.customCommonJS type="module")
        script(src=CDNS.customValidationJS type="module") 

        block inline_js

        block js_link

        title #{title}
    body
        #loader-backdrop.d-none
        #loader.d-none
            <div class="spinner-grow text-primary" role="status">
                <span class="visually-hidden">Loading...</span>
            </div>
        #is-mobile-container.d-none
            .d-flex.justify-content-center.align-items-center
                p.fw-bold.fs-5.text-danger.text-center.mt-5.px-2 To ensure an optimal browsing experience, please access the website using a laptop or desktop.

        main
            include ./includes/header.pug

            block content



