doctype html
html
  head
    meta(charset="utf-8")
    meta(charset='utf-8')
    meta(http-equiv='X-UA-Compatible' content='IE=edge')
    meta(http-equiv='Cache-control' content='no-cache')
    meta(http-equiv='Expires' content='-1')
    meta(name='viewport' content='width=device-width, initial-scale=1.0, minimum-scale=1.0, maximum-scale=1.0, user-scalable=0')
    title #{title}

    link(rel="stylesheet", href=CDNS.bootstrapCSS)
    link(rel="stylesheet", href=CDNS.fontAwesomeCSS)
    link(rel='stylesheet' href=CDN_URL+'/assets/css/home-page.css')
    block css_link

    block aggrement_page_css_link
    block inline_css

    //- JS 
    script(src=CDNS.jquery)
    script(src=CDNS.jqueryValidate)
    script(src=CDNS.jqueryValidateAdditional)

    script(src=CDNS.popperJs)
    script(src=CDNS.bootstrapJS)
    script(src=CDNS.sweetAlertJs)
    script(src=CDNS.fontAwesomeJS)

    script(src=CDNS.customCommonJS type="module")
    script(src=CDNS.customValidationJS type="module") 

    script.
      $('input').tooltip();
      $(function(){
        $(document).on('keyup','input',function(){
          var text = $(this).val();
          text = text.toUpperCase();
          $(this).val(text)
        });
        $(document).on('keyup','textarea',function(){
          var text = $(this).val();
          text = text.toUpperCase();
          $(this).val(text)
        });
        $('input').bind('copy paste cut',function(e) { 
          e.preventDefault(); //disable cut,copy,paste
          });
        $('textarea').bind('copy paste cut',function(e) { 
          e.preventDefault(); //disable cut,copy,paste
        });
        $(document).on('blur','#gPercent',function(){
          var value = Number($(this).val());
          if(value < 45){
            alertjs.warning(
              {
                t: "Warning",

                m: "Invalid graduation criteria",
              },

              function () {
                $('#gPercent').val('');
              }
            );

          }
        });
      })
  block inline_js

  block js_link

  body.welcome(oncontextmenu="return false;" ondragstart='return false;' ondrop='return false;')
    block content
